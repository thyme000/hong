<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.thyme.memory.db.MemoryMapper">

    <select id="findById" resultType="cn.thyme.memory.db.MemoryRow">
        SELECT id, content, metadata FROM memory_record WHERE id = #{id}
    </select>

    <delete id="deleteById">
        DELETE FROM memory_record WHERE id = #{id}
    </delete>

    <select id="listAll" resultType="cn.thyme.memory.db.MemoryRow">
        SELECT id, content, metadata FROM memory_record ORDER BY id
    </select>

</mapper>
